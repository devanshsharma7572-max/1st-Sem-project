
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Resume Page</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px auto;
            max-width: 800px;
            padding: 20px;
            line-height: 1.6;
            background-color: #f4f4f4;
            color: #222;
        }

        h1, h2, h3 {
            color: #222;
        }

        .section {
            background-color: white;
            padding: 15px;
            margin-top: 20px;
            border: 1px solid #ccc;
            border-radius: 8px;
        }

        hr {
            border: 0;
            border-top: 2px solid #555;
        }
    </style>
</head>

<body>

    <!-- Main heading of the resume -->
    <h1>My Resume</h1>
    <h2>Devansh Sharma</h2>
    <h3>B.Tech Student</h3>

    <hr>

    <!-- Introduction section -->
    <p>
        Hello! My name is <strong>Devansh Sharma</strong>.
        I am a <em>B.Tech student</em> interested in programming
        and web development. I want to improve my coding skills
        and become a successful software developer.
    </p>

    <!-- Skills section -->
    <div id="skills" class="section">
        <h2>My Skills</h2>
        <p>HTML</p>
        <p>CSS</p>
        <p>Java Programming</p>
        <p>Problem Solving</p>
    </div>

    <!-- Education section -->
    <div id="education" class="section">
        <h2>Education</h2>
        <p><strong>Course:</strong> B.Tech</p>
        <p><strong>Branch:</strong> Computer Science Engineering</p>
        <p><strong>University:</strong> Invertis University</p>
        <p><strong>12th:</strong> Completed in 2026</p>
    </div>

    <!-- Contact section -->
    <div id="contact" class="section">
        <h2>Contact Information</h2>
        <p>Email: your-email@example.com</p>
        <p>Location: Uttar Pradesh, India</p>
    </div>

</body>
</html>
